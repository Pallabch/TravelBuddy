{
  "name": "@travel-buddy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "ping": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/ping.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local ./node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@travel-buddy/validators": "workspace:*",
    "@vercel/functions": "^3.10.5",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
