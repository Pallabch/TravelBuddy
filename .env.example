# `neon deploy` writes the real values to .env.local. Do not commit that file.
# App queries use the pooled URL (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DATABASE_URL_UNPOOLED=""
NEON_AUTH_BASE_URL=""
NEON_AUTH_JWKS_URL=""
# Not issued by Neon. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
